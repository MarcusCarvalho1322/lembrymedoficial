# ═══════════════════════════════════════════════════════════
# LEMBRYMED — Variáveis de Ambiente
# Copie para .env na raiz do projeto e preencha.
# Em produção (VPS), este arquivo fica em /opt/lembrymed/.env
# ═══════════════════════════════════════════════════════════

# ── AMBIENTE ────────────────────────────────────────────────
# "development" | "production" | "test"
NODE_ENV=production

# ── BANCO DE DADOS (PostgreSQL self-hosted em container) ────
# Estes valores alimentam o container postgres do docker-compose.
# Em desenvolvimento local você pode usar lembrymed / lembrymed_dev / lembrymed.
POSTGRES_USER=lembrymed
POSTGRES_PASSWORD=troque-por-senha-forte
POSTGRES_DB=lembrymed
# A DATABASE_URL é montada automaticamente pelo docker-compose.
# Formato: postgresql://USUARIO:SENHA@postgres:5432/BANCO

# ── REDIS (container Docker) ────────────────────────────────
# Usado por BullMQ (filas) e dedup de webhook.
# Dentro do docker-compose já configurado como redis://redis:6379

# ── WHATSAPP (Z-API) ────────────────────────────────────────
WHATSAPP_PROVIDER=zapi

# 1. z-api.io → criar conta → criar instância
# 2. escaneie o QR Code com o WhatsApp do Lembrymed
# 3. copie Instance ID e Token do painel
ZAPI_INSTANCE_ID=your_zapi_instance_id
ZAPI_TOKEN=your_zapi_token
ZAPI_CLIENT_TOKEN=your_zapi_client_token

# Token de segurança do webhook — OBRIGATÓRIO em produção.
# Configure no painel Z-API → Settings → Webhook Security Token.
# Gere com: `openssl rand -hex 24` (mínimo 16 caracteres).
ZAPI_WEBHOOK_TOKEN=

# ── STRIPE ──────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ANNUAL=price_xxx
# ── Planos comerciais (V2.2): Prata e Ouro ───────────────────
# Crie os preços no Stripe (Product → Pricing) e cole os IDs aqui:
#   Prata R$ 149/ano (lembretes individuais, sem alerta familiar)
#   Ouro  R$ 239/ano (lembretes + alerta ao cuidador + relatórios)
STRIPE_PRICE_SILVER=price_xxx
STRIPE_PRICE_GOLD=price_xxx
# Publishable key (não é secreta mas é necessária se usar Stripe Elements):
STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# ── IA / LLM ──────────────────────────────────────────────────
# Provider: 'deepseek' (recomendado, 70%+ economia) ou 'anthropic' (fallback)
LLM_PROVIDER=deepseek

# DeepSeek V3 (recomendado)
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic Claude (fallback — mantenha para emergências)
# https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxx

# ── URLS ────────────────────────────────────────────────────
API_URL=https://api.lembrymed.com.br
WEB_URL=https://lembrymed.com.br

# ── ADMIN (JWT) ─────────────────────────────────────────────
# Email único com acesso ao painel admin
ADMIN_EMAIL=marcus@bizzia.com.br
# Hash bcrypt da senha — gerar com:
#   node -e "require('bcryptjs').hash('SUA_SENHA', 12).then(console.log)"
ADMIN_PASSWORD_HASH=
# Segredo JWT — OBRIGATÓRIO (mínimo 32 caracteres).
# Gerar: `openssl rand -base64 32`
NEXTAUTH_SECRET=

# ── OBSERVABILIDADE (opcional) ──────────────────────────────
# Sentry DSN para captura de erros — recomendado
SENTRY_DSN=
LOG_LEVEL=info

# ── APP ─────────────────────────────────────────────────────
PORT=3000
